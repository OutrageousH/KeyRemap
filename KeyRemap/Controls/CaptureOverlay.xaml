<UserControl x:Class="KeyRemap.Controls.CaptureOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid Background="#B3000000">
        <Border Width="500"
                Padding="28,26"
                CornerRadius="14"
                Background="{DynamicResource SurfaceBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.28" Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <TextBlock x:Name="TitleLabel" Style="{StaticResource H2Text}" />
                <TextBlock x:Name="HintLabel"
                           Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />

                <Border Margin="0,18,0,0"
                        Padding="18,22"
                        MinHeight="96"
                        CornerRadius="10"
                        Background="{DynamicResource SurfaceSunkenBrush}">
                    <TextBlock x:Name="KeysLabel"
                               FontSize="23"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="StatusLabel"
                           Style="{StaticResource HintText}"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center" />

                <TextBlock x:Name="ReasonLabel"
                           FontSize="12.5"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"
                           Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelButton"
                            Content="取消"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="94"
                            AutomationProperties.Name="取消键位选择"
                            Click="OnCancel" />
                    <Button x:Name="RetryButton"
                            Content="重试"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="94"
                            Margin="10,0,0,0"
                            Visibility="Collapsed"
                            AutomationProperties.Name="重试键位选择"
                            Click="OnRetry" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
