<Window x:Class="KeyRemap.Controls.CloseChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="430"
        WindowStartupLocation="CenterOwner"
        Title="关闭按键映射">
    <Border Margin="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.20" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="24,22,24,20">
            <TextBlock Text="关闭按键映射" Style="{StaticResource H2Text}" />
            <TextBlock Style="{StaticResource BodyText}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Text="你想让按键映射怎么处理这个窗口？最小化到托盘后程序继续在后台运行，按键覆盖保持生效。" />

            <CheckBox x:Name="RememberBox"
                      Style="{StaticResource AppCheckBox}"
                      IsChecked="True"
                      Margin="0,16,0,0"
                      AutomationProperties.Name="记住我的选择"
                      Content="记住我的选择（之后可在软件设置中更改）" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="最小化到托盘"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="118"
                        AutomationProperties.Name="最小化到托盘"
                        Click="OnMinimize" />
                <Button Content="退出程序"
                        Style="{StaticResource DangerButton}"
                        MinWidth="100"
                        Margin="10,0,0,0"
                        AutomationProperties.Name="退出程序"
                        Click="OnExit" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
