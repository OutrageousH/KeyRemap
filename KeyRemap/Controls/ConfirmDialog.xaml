<Window x:Class="KeyRemap.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="400"
        WindowStartupLocation="CenterOwner"
        Title="确认">
    <Border Margin="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.20" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="24,22,24,20">
            <TextBlock x:Name="TitleText" Style="{StaticResource H2Text}" />
            <TextBlock x:Name="MessageText"
                       Style="{StaticResource BodyText}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="取消"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="92"
                        IsCancel="True"
                        Click="OnCancel" />
                <Button x:Name="OkButton"
                        Content="确定"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="92"
                        Margin="10,0,0,0"
                        IsDefault="True"
                        Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
