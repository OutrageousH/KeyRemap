<Window x:Class="KeyRemap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:KeyRemap.Core"
        xmlns:controls="clr-namespace:KeyRemap.Controls"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterScreen"
        Title="按键映射"
        Width="900"
        Height="620"
        MinWidth="680"
        MinHeight="440">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部 ==================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="按键映射" Style="{StaticResource H1Text}" />
                <TextBlock Style="{StaticResource HintText}"
                           Margin="0,4,0,0"
                           Text="定义按键覆盖规则，原键行为会被目标键替换。" />
            </StackPanel>

            <Border Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    Padding="12,7"
                    CornerRadius="16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1"
                    ToolTip="按键覆盖总开关的当前状态">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="CoverageDot"
                             Width="8"
                             Height="8"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="CoverageLabel"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12" />
                    <TextBlock x:Name="CoverageHotkeyLabel"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <Button Grid.Column="2"
                    Style="{StaticResource IconButton}"
                    Content="&#xE713;"
                    ToolTip="软件设置"
                    AutomationProperties.Name="软件设置"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Click="OnOpenSettings" />

            <Button Grid.Column="3"
                    Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="新增按键定义方案"
                    Click="OnAddProfile">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="新增按键定义方案"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ==================== 主体：方案列表 ==================== -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,0">
                <ItemsControl x:Name="ProfileList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:Profile}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 名称 + 紧邻的重命名按钮 -->
                                    <Border Grid.Column="0"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="OnProfileRowClick">
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource H2Text}"
                                                           VerticalAlignment="Center" />
                                                <Button Style="{StaticResource IconButton}"
                                                        Content="&#xE70F;"
                                                        ToolTip="重命名"
                                                        AutomationProperties.Name="重命名"
                                                        FontSize="11"
                                                        Width="26"
                                                        Height="26"
                                                        Margin="7,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Click="OnRenameProfile" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <controls:StateSwitch Grid.Column="1"
                                                          Margin="12,0"
                                                          VerticalAlignment="Center"
                                                          State="{Binding SwitchState}"
                                                          Toggled="OnProfileToggled" />

                                    <Button Grid.Column="2"
                                            Style="{StaticResource IconButton}"
                                            Content="&#xE713;"
                                            ToolTip="设置按键覆盖"
                                            AutomationProperties.Name="设置按键覆盖"
                                            VerticalAlignment="Center"
                                            Click="OnEditProfile" />

                                    <Button Grid.Column="3"
                                            Style="{StaticResource DangerIconButton}"
                                            Content="&#xE74D;"
                                            ToolTip="删除方案"
                                            AutomationProperties.Name="删除方案"
                                            VerticalAlignment="Center"
                                            Margin="4,0,0,0"
                                            Click="OnDeleteProfile" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空态 -->
            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="&#xE765;"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="34"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="还没有按键方案"
                           Style="{StaticResource H2Text}"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="点击右上角「新增按键定义方案」开始。"
                           Style="{StaticResource HintText}"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ==================== 底部 ==================== -->
        <TextBlock x:Name="FooterText"
                   Grid.Row="2"
                   Style="{StaticResource HintText}"
                   Margin="0,14,0,0"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
