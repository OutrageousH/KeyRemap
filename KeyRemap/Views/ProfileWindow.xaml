<Window x:Class="KeyRemap.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:KeyRemap.Core"
        xmlns:controls="clr-namespace:KeyRemap.Controls"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterOwner"
        Title="按键定义"
        Width="900"
        Height="640"
        MinWidth="700"
        MinHeight="460">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 功能栏 ==================== -->
        <Grid Grid.Row="0" Margin="24,20,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource SecondaryButton}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="返回"
                    Click="OnBack">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="返回" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                <TextBlock x:Name="ProfileNameText" Style="{StaticResource H2Text}" />
                <TextBlock x:Name="ProfileSummaryText"
                           Style="{StaticResource HintText}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <Button Grid.Column="2"
                    Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="新增覆盖"
                    Click="OnAddRule">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="新增覆盖" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ==================== 总覆盖栏 ==================== -->
        <Border Grid.Row="1"
                Margin="24,18,24,20"
                Padding="14"
                CornerRadius="12"
                Background="{DynamicResource SurfaceSunkenBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,0">
                <StackPanel>
                    <ItemsControl x:Name="RuleList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:Rule}">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <controls:StateSwitch Grid.Row="0"
                                                              Grid.Column="0"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,14,0"
                                                              State="{Binding SwitchState}"
                                                              Toggled="OnRuleToggled" />

                                        <Button Grid.Row="0"
                                                Grid.Column="1"
                                                Style="{StaticResource KeySlotButton}"
                                                AutomationProperties.Name="被覆盖键"
                                                Click="OnPickSource">
                                            <TextBlock Text="{Binding SourceDisplay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSource}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                <Setter Property="FontStyle" Value="Italic" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="2"
                                                   Text="&#xE72A;"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0" />

                                        <Button Grid.Row="0"
                                                Grid.Column="3"
                                                Style="{StaticResource KeySlotButton}"
                                                AutomationProperties.Name="目标键"
                                                Click="OnPickTarget">
                                            <TextBlock Text="{Binding TargetDisplay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTarget}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                <Setter Property="FontStyle" Value="Italic" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <Button Grid.Row="0"
                                                Grid.Column="4"
                                                Style="{StaticResource DangerIconButton}"
                                                Content="&#xE74D;"
                                                ToolTip="删除该覆盖"
                                                AutomationProperties.Name="删除该覆盖"
                                                VerticalAlignment="Center"
                                                Margin="14,0,0,0"
                                                Click="OnDeleteRule" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="4"
                                                   Text="{Binding Reason}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   Margin="0,8,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Valid}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,2"
                            AutomationProperties.Name="新增覆盖（底部）"
                            Click="OnAddRule"
                            Content="+  新增覆盖" />

                    <TextBlock x:Name="RulesEmptyHint"
                               Style="{StaticResource HintText}"
                               Margin="2,10,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Text="当前方案还没有覆盖规则。新增一条后，设置「被覆盖键」与「目标键」即可生效。" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <controls:CaptureOverlay x:Name="Capture" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</Window>
