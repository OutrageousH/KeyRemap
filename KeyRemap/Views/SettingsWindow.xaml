<Window x:Class="KeyRemap.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KeyRemap.Controls"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterOwner"
        Title="软件设置"
        Width="720"
        Height="700"
        MinWidth="620"
        MinHeight="520">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,20,18,0">

            <StackPanel>
                <TextBlock Text="软件设置" Style="{StaticResource H1Text}" />
                <TextBlock Style="{StaticResource HintText}"
                           Margin="0,4,0,0"
                           Text="所有设置即时生效并保存在程序同目录的 config.json 中。" />

                <!-- ==================== 快捷键 ==================== -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="开关快捷键" Style="{StaticResource SectionTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="按键覆盖总开关"
                                       Style="{StaticResource RowLabel}"
                                       Margin="0,0,16,0" />

                            <Button x:Name="HotkeySlot"
                                    Grid.Column="1"
                                    Style="{StaticResource KeySlotButton}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="开关快捷键"
                                    Click="OnChangeHotkey">
                                <TextBlock x:Name="HotkeyText" FontSize="{StaticResource BodySize}" />
                            </Button>

                            <Button Grid.Column="2"
                                    Content="更改"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0"
                                    AutomationProperties.Name="更改快捷键"
                                    Click="OnChangeHotkey" />

                            <Button x:Name="ClearHotkeyButton"
                                    Grid.Column="3"
                                    Content="清除"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="清除快捷键"
                                    Click="OnClearHotkey" />
                        </Grid>

                        <TextBlock x:Name="HotkeyHint"
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Text="该快捷键全局生效，程序运行期间无论焦点在哪个窗口都有效。按下后切换按键覆盖总开关。" />
                    </StackPanel>
                </Border>

                <!-- ==================== 关闭行为 ==================== -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="关闭窗口时" Style="{StaticResource SectionTitle}" />

                        <StackPanel x:Name="CloseBehaviorPanel" Orientation="Horizontal">
                            <Button x:Name="CloseAskButton"
                                    Content="每次询问"
                                    Style="{StaticResource PillButton}"
                                    AutomationProperties.Name="关闭时每次询问"
                                    Click="OnCloseAsk" />
                            <Button x:Name="CloseTrayButton"
                                    Content="最小化到系统托盘"
                                    Style="{StaticResource PillButton}"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="关闭时最小化到托盘"
                                    Click="OnCloseTray" />
                            <Button x:Name="CloseExitButton"
                                    Content="退出程序"
                                    Style="{StaticResource PillButton}"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="关闭时退出程序"
                                    Click="OnCloseExit" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== 个性化 ==================== -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="个性化" Style="{StaticResource SectionTitle}" />

                        <!-- 外观模式 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="外观模式"
                                       Style="{StaticResource RowLabel}"
                                       Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="AppearanceSolidButton"
                                        Content="纯色"
                                        Style="{StaticResource PillButton}"
                                        AutomationProperties.Name="外观模式纯色"
                                        Click="OnAppearanceSolid" />
                                <Button x:Name="AppearanceGlassButton"
                                        Content="毛玻璃"
                                        Style="{StaticResource PillButton}"
                                        Margin="8,0,0,0"
                                        AutomationProperties.Name="外观模式毛玻璃"
                                        Click="OnAppearanceGlass" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="AppearanceHint"
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />

                        <!-- 颜色 -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="背景色"
                                       Style="{StaticResource RowLabel}" Margin="0,0,16,0" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <Border x:Name="BackgroundSwatch" Style="{StaticResource ColorSwatch}" />
                                <TextBlock x:Name="BackgroundHex" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Button Grid.Row="0" Grid.Column="2" Content="选择…"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="选择背景色"
                                    Click="OnPickBackground" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="边框色"
                                       Style="{StaticResource RowLabel}" Margin="0,10,16,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Border x:Name="BorderSwatch" Style="{StaticResource ColorSwatch}" />
                                <TextBlock x:Name="BorderHex" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Button Grid.Row="1" Grid.Column="2" Content="选择…"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="选择边框色"
                                    Click="OnPickBorder" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="主色调"
                                       Style="{StaticResource RowLabel}" Margin="0,10,16,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Border x:Name="AccentSwatch" Style="{StaticResource ColorSwatch}" />
                                <TextBlock x:Name="AccentHex" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Button Grid.Row="2" Grid.Column="2" Content="选择…"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="选择主色调"
                                    Click="OnPickAccent" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="文字色"
                                       Style="{StaticResource RowLabel}" Margin="0,10,16,0" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Border x:Name="TextSwatch" Style="{StaticResource ColorSwatch}" />
                                <TextBlock x:Name="TextHex" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="自动"
                                        Style="{StaticResource SecondaryButton}"
                                        AutomationProperties.Name="文字色自动"
                                        Click="OnTextAuto" />
                                <Button Content="选择…"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0"
                                        AutomationProperties.Name="选择文字色"
                                        Click="OnPickText" />
                            </StackPanel>
                        </Grid>

                        <!-- 图标 -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="应用图标"
                                       Style="{StaticResource RowLabel}" Margin="0,0,16,0" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="6"
                                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                    <Image x:Name="IconPreview" Stretch="Uniform" />
                                </Border>
                                <TextBlock x:Name="IconStateText" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                <Button Content="更改图标…"
                                        Style="{StaticResource SecondaryButton}"
                                        AutomationProperties.Name="更改图标"
                                        Click="OnChangeIcon" />
                                <Button x:Name="ResetIconButton"
                                        Content="恢复默认"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0"
                                        AutomationProperties.Name="恢复默认图标"
                                        Click="OnResetIcon" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="文件夹图标"
                                       Style="{StaticResource RowLabel}" Margin="0,12,16,0" />
                            <TextBlock x:Name="FolderIconHint"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Style="{StaticResource HintText}"
                                       VerticalAlignment="Center"
                                       Margin="0,12,8,0"
                                       TextWrapping="Wrap" />
                            <Button x:Name="FolderIconButton"
                                    Grid.Row="1" Grid.Column="2"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,12,0,0"
                                    AutomationProperties.Name="切换文件夹图标"
                                    Click="OnToggleFolderIcon" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="恢复默认外观"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="恢复默认外观"
                                    Click="OnResetTheme" />
                            <TextBlock x:Name="ThemeContrastHint"
                                       Style="{StaticResource HintText}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== 关于 ==================== -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="AboutText"
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"
                                   LineHeight="19" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="打开程序目录"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="打开程序目录"
                                    Click="OnOpenFolder" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="24,14,24,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="关闭"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="96"
                        IsCancel="True"
                        AutomationProperties.Name="关闭设置"
                        Click="OnClose" />
            </StackPanel>
        </Border>

        <controls:CaptureOverlay x:Name="Capture" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</Window>
